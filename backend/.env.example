MODEL_API_KEY=replace-with-meta-model-api-key
META_BASE_URL=https://api.meta.ai/v1
META_CHAT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_AGENT_MAX_TOKENS=1024
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FIREBASE_CREDENTIALS_PATH=replace-with-path-to-service-account-json
ALLOWED_ORIGINS=*
MAX_AUDIO_UPLOAD_BYTES=10485760
MAX_AUDIO_DURATION_SECONDS=120
REQUIRE_HTTPS=false
